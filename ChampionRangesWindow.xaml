<Window x:Class="RiftPen.ChampionRangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Champion ability ranges" Width="640" Height="520"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                   Text="Pick a champion, tick the ranges you want, and add them as range circles. Data comes from Riot's official Data Dragon for the current patch. A few abilities list a cast distance that isn't their real reach (dashes, global ultimates), so double-check odd ones."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#555"/>
            <Button x:Name="AddBtn" Content="Add ticked ranges" Padding="12,4" Margin="0,0,8,0" Click="Add_Click" IsEnabled="False"/>
            <Button Content="Close" Padding="12,4" Click="Close_Click"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="0,0,0,6" Padding="4,3" TextChanged="Search_TextChanged"/>
                <ListBox x:Name="ChampList" DisplayMemberPath="Name" SelectionChanged="ChampList_SelectionChanged"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="ChampTitle" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" Text="Loading champions…"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RangeChecks"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
