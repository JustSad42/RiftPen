<Window x:Class="RiftPen.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RiftPen Settings" Width="680" Height="800"
        Topmost="True" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Margin="8">

        <!-- ============ Shortcuts ============ -->
        <TabItem Header="Shortcuts">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Note}">
                        Click a shortcut, then press a key, key combo, or mouse button (middle, Mouse 4, Mouse 5).
                        <Run FontWeight="SemiBold">Esc</Run> cancels and <Run FontWeight="SemiBold">Backspace</Run> removes the shortcut.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Note}">
                        <Run FontWeight="SemiBold">While drawing</Run>: only while draw mode is on, so it doesn't interfere with typing.
                        <Run FontWeight="SemiBold">In League</Run>: also while League (or RiftPen) is the focused window. Other apps still receive that key.
                        <Run FontWeight="SemiBold">Everywhere</Run>: works in any app, and that key is taken over everywhere.
                    </TextBlock>
                    <TextBlock x:Name="HotkeyWarn" Foreground="#B00020" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CaptureNote" Foreground="#0B5CAD" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Reset all shortcuts" Click="ResetShortcuts_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ShortcutList"/>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ============ Range circles ============ -->
        <TabItem Header="Range circles">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Note}"
                               Text="Pick a size from the toolbar's range button (or its shortcut), then click the map. The circle goes on the ground at that spot; drag before letting go to adjust it. With the select tool, scroll over a circle to resize it. Sizes are in League game units. Edit a cell by double-clicking it, typing, then pressing Enter."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Add champion ability ranges…" Click="ChampionRanges_Click" Margin="0,0,12,0"/>
                        <CheckBox Content="Show the name on each range circle" IsChecked="{Binding ShowRangeLabels}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add" Click="AddRange_Click" Margin="0,0,6,0"/>
                    <Button Content="Remove selected" Click="RemoveRange_Click" Margin="0,0,6,0"/>
                    <Button Content="Move up" Click="MoveRangeUp_Click" Margin="0,0,6,0"/>
                    <Button Content="Reset to defaults" Click="ResetRanges_Click"/>
                </StackPanel>
                <DataGrid x:Name="RangeGrid" ItemsSource="{Binding RangePresets}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                          SelectionMode="Single" Margin="0,6,0,0" RowEditEnding="RangeGrid_RowEditEnding">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="16" Height="16" StrokeThickness="2" Stroke="{Binding Color}" Margin="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Radius (units)" Binding="{Binding Radius}" Width="110"/>
                        <DataGridTextColumn Header="Color (#RRGGBB)" Binding="{Binding Color}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ============ Replay ============ -->
        <TabItem Header="Replay">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Map drawings and replay control use Riot's official Replay API, which only runs in replays and spectator mode, never in your own live games. RiftPen never reads game memory."/>

                    <TextBlock Text="Timeline notes" Style="{StaticResource H}"/>
                    <CheckBox Content="Tie drawings made in a replay to that moment in the replay" IsChecked="{Binding TimelineEnabled}"/>
                    <TextBlock Style="{StaticResource Note}" Margin="22,0,0,4"
                               Text="Notes appear when the replay reaches that moment and fade out afterwards, including when you rewind or rewatch. They're saved per replay automatically."/>
                    <Grid Margin="22,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Each note stays for" VerticalAlignment="Center"/>
                        <Slider x:Name="DurationSlider" Grid.Column="1" Minimum="0" Maximum="120" Margin="0,4" IsSnapToTickEnabled="True" TickFrequency="5"
                                Value="{Binding NoteDurationSec}"/>
                        <TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <CheckBox Content="Pause the replay while I'm drawing (resumes when I stop)" IsChecked="{Binding PauseWhileDrawing}" Margin="0,8,0,3"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Delete this replay's notes" Click="DeleteThisReplay_Click" Margin="0,0,8,0"/>
                        <Button Content="Delete notes for all replays" Click="DeleteAllReplays_Click"/>
                    </StackPanel>

                    <Separator Margin="0,12"/>
                    <TextBlock Text="Minimap" Style="{StaticResource H}"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Mark where the minimap is once (per HUD layout). Then map drawings also show on the minimap, and you can draw on the minimap to place drawings anywhere on the map."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Set minimap area…" Click="PickMinimap_Click" Margin="0,0,10,0"/>
                        <TextBlock x:Name="MinimapStatus" VerticalAlignment="Center" Foreground="#555"/>
                    </StackPanel>
                    <CheckBox Content="Show map drawings on the minimap" IsChecked="{Binding MirrorToMinimap}"/>
                    <CheckBox Content="Drawing on the minimap places drawings on the map" IsChecked="{Binding MinimapInput}"/>

                    <Separator Margin="0,12"/>
                    <TextBlock Text="Replay API setup" Style="{StaticResource H}"/>
                    <TextBlock Text="League game.cfg" Margin="0,0,0,2"/>
                    <DockPanel>
                        <Button Content="Browse…" DockPanel.Dock="Right" Margin="6,0,0,0" Click="Browse_Click"/>
                        <TextBox x:Name="CfgPath" Text="{Binding GameCfgPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <Button Content="Turn on the Replay API in game.cfg" HorizontalAlignment="Left" Margin="0,8,0,4" Click="EnableReplayApi_Click"/>

                    <Separator Margin="0,12"/>
                    <TextBlock Text="Live camera" Style="{StaticResource H}"/>
                    <TextBlock x:Name="CamText" FontFamily="Consolas" Margin="0,0,0,4"/>

                    <Separator Margin="0,12"/>
                    <TextBlock Text="Smoothness" Style="{StaticResource H}"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="If map drawings trail behind while the camera pans, add a little look-ahead. Raise it until drawings stay glued while panning; too much makes them overshoot when you stop. 0 is off."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Look-ahead (ms)" VerticalAlignment="Center"/>
                        <Slider x:Name="PredSlider" Grid.Column="1" Minimum="0" Maximum="40" Margin="0,4" IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding PredictionMs}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=PredSlider, StringFormat={}{0:0}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <Separator Margin="0,12"/>
                    <TextBlock Text="Calibration" Style="{StaticResource H}"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="1) Open a replay and use the default top-down camera with the blue base at the bottom-left.  2) Press Auto-calibrate.  3) Turn on the test grid and pan, zoom and scrub. The grid should stay glued to the ground. If it slides, try the options below."/>
                    <WrapPanel Margin="0,4,0,8">
                        <Button Content="Auto-calibrate" Click="AutoCal_Click" Margin="0,0,8,0"/>
                        <Button Content="Reset to defaults" Click="Reset_Click" Margin="0,0,12,0"/>
                        <CheckBox Content="Show test grid" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Yaw offset (°)" VerticalAlignment="Center"/>
                        <Slider x:Name="YawSlider" Grid.Column="1" Minimum="-180" Maximum="180" Margin="0,4"
                                Value="{Binding Calibration.YawOffset}" SmallChange="1" LargeChange="15"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=YawSlider, StringFormat={}{0:0.0}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Row="1" Text="FOV scale" VerticalAlignment="Center"/>
                        <Slider x:Name="FovSlider" Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="1.5" Margin="0,4"
                                Value="{Binding Calibration.FovScale}" SmallChange="0.01" LargeChange="0.05"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=FovSlider, StringFormat={}{0:0.00}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Row="2" Text="Ground height" VerticalAlignment="Center"/>
                        <Slider x:Name="GroundSlider" Grid.Row="2" Grid.Column="1" Minimum="-200" Maximum="300" Margin="0,4"
                                Value="{Binding Calibration.GroundHeight}" SmallChange="5" LargeChange="25"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=GroundSlider, StringFormat={}{0:0}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <WrapPanel Margin="0,6,0,0">
                        <CheckBox Content="Invert yaw" IsChecked="{Binding Calibration.InvertYaw}" Margin="0,3,16,3"/>
                        <CheckBox Content="Invert pitch" IsChecked="{Binding Calibration.InvertPitch}" Margin="0,3,16,3"/>
                        <CheckBox Content="Swap yaw/pitch" IsChecked="{Binding Calibration.SwapYawPitch}" Margin="0,3,16,3"/>
                        <CheckBox Content="FOV is horizontal" IsChecked="{Binding Calibration.FovIsHorizontal}" Margin="0,3,16,3"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============ General ============ -->
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="Startup" Style="{StaticResource H}"/>
                    <CheckBox x:Name="StartupBox" Content="Start RiftPen with Windows" Click="Startup_Click"/>
                    <CheckBox Content="Bring back my drawings when RiftPen starts" IsChecked="{Binding RestoreDrawings}"/>
                    <TextBlock Style="{StaticResource Note}" Margin="22,0,0,4"
                               Text="RiftPen lives in the notification area (system tray) too: left-click its icon to show or hide the toolbar, right-click for more."/>

                    <Separator Margin="0,10"/>
                    <TextBlock Text="Drawing" Style="{StaticResource H}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Laser stays for (seconds)" VerticalAlignment="Center"/>
                        <Slider x:Name="LaserSlider" Grid.Column="1" Minimum="0.3" Maximum="5" Margin="0,4" IsSnapToTickEnabled="True" TickFrequency="0.1"
                                Value="{Binding LaserSeconds}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=LaserSlider, StringFormat={}{0:0.0}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <CheckBox Content="Hide map drawings when League isn't the focused window" IsChecked="{Binding HideWorldWhenLeagueNotFocused}"/>

                    <Separator Margin="0,10"/>
                    <TextBlock Text="Screenshots" Style="{StaticResource H}"/>
                    <TextBlock Text="Save to" Margin="0,0,0,2"/>
                    <DockPanel>
                        <Button Content="Open" DockPanel.Dock="Right" Margin="6,0,0,0" Click="OpenShots_Click"/>
                        <Button Content="Browse…" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseShots_Click"/>
                        <TextBox Text="{Binding ScreenshotFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <CheckBox Content="Also copy each screenshot to the clipboard" IsChecked="{Binding ScreenshotToClipboard}" Margin="0,6,0,3"/>

                    <Separator Margin="0,10"/>
                    <TextBlock Text="Display" Style="{StaticResource H}"/>
                    <CheckBox Content="Fast rendering (GPU, smooth at high refresh rates). Takes effect after restarting RiftPen." IsChecked="{Binding FastRendering}"/>
                    <TextBlock Style="{StaticResource Note}" Margin="22,0,0,8"
                               Text="Turn this off only if the overlay shows a black or solid background instead of being see-through."/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Move overlay to next monitor" Click="NextMonitor_Click"/>
                        <TextBlock x:Name="MonitorText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#555"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
