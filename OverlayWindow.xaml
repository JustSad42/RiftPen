<Window x:Class="RiftPen.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RiftPen"
        Title="RiftPen Overlay"
        WindowStyle="None" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Left="0" Top="0" Width="800" Height="600">
    <Grid>
        <local:DrawCanvas x:Name="Surface"/>
        <Canvas x:Name="EditLayer"/>
    </Grid>
</Window>
